rules_version = '2';

// The database lock for the coaching app. Who may read and write is the access list teamData/access,
// which a head coach / admin's app keeps in step with the staff list (src/services/storageService.ts,
// syncAccessDoc). The program owner is written in here so the list can always be fixed.
//
//   admins   - head coaches / admins: everything, and the access list
//   coaches  - read and write team data
//   viewers  - players and families: read only (plus "who's online")
//   anyone else signed in with a verified email - may only ask to join (signups/<their email>)
//
// Publish with: npx firebase-tools deploy --only firestore:rules,storage --project u-football-manager
service cloud.firestore {
  match /databases/{database}/documents {
    // Google accounts, and email / password accounts that clicked their verification link.
    function verified() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    function owner() {
      return verified() && me() in ['dannym1010@gmail.com'];
    }
    function accessPath() {
      return /databases/$(database)/documents/teamData/access;
    }
    function listed(group) {
      return verified()
        && exists(accessPath())
        && me() in get(accessPath()).data.get(group, {});
    }
    function admin() {
      return owner() || listed('admins');
    }
    function coach() {
      return admin() || listed('coaches');
    }
    function viewer() {
      return coach() || listed('viewers');
    }

    match /teamData/{docId} {
      allow read: if viewer();
      // The access list: admins only. Players and families only say they're online.
      allow write: if docId == 'access'
        ? admin()
        : coach() || (viewer() && docId == 'ops_presence');
    }

    // A new account asks to join; an admin's app adds it to the staff list and clears the request.
    match /signups/{email} {
      allow create, update: if verified()
        && email == me()
        && request.resource.data.email == me();
      allow read, delete: if admin();
    }

    // Anything else: nobody.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
